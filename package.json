{
  "name": "athar",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "node scripts/standalone-server.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests --exclude tests/integration/**",
    "test:integration": "node --env-file=.env node_modules/vitest/vitest.mjs run tests/integration",
    "test:e2e": "node --env-file=.env node_modules/@playwright/test/cli.js test",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "node scripts/seed.mjs",
    "db:backup": "node scripts/sqlite-backup.mjs",
    "db:backup:verify": "node scripts/sqlite-backup-verify.mjs",
    "setup:dev": "node scripts/setup-dev.mjs",
    "setup:production-env": "node scripts/setup-production-env.mjs",
    "providers:verify": "node scripts/provider-smoke.mjs",
    "docker:config": "docker compose config",
    "docker:build": "docker build --target runner -t athar:local ."
  },
  "dependencies": {
    "@fontsource/noto-sans-arabic": "^5.3.0",
    "@hookform/resolvers": "latest",
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/client": "latest",
    "@react-pdf/renderer": "^4.6.1",
    "@tailwindcss/postcss": "latest",
    "better-sqlite3": "^13.0.3",
    "es-toolkit": "1.39.3",
    "exceljs": "^4.4.0",
    "lucide-react": "latest",
    "next": "latest",
    "next-auth": "latest",
    "pdf-parse": "^1.1.1",
    "react": "latest",
    "react-dom": "latest",
    "recharts": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@eslint/eslintrc": "latest",
    "@playwright/test": "^1.62.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "postcss": "latest",
    "prettier": "latest",
    "prisma": "latest",
    "tailwindcss": "latest",
    "typescript": "latest",
    "vitest": "latest"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    },
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
