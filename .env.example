DATABASE_URL="file:./data/athar.db"
NODE_ENV="production"
APP_URL="http://localhost:3000"
AUTH_SECRET="base64-encoded-random-secret-at-least-32-bytes"
APP_ENCRYPTION_KEY="base64-encoded-exactly-32-byte-key"
LOOKUP_HMAC_SECRET="base64-encoded-random-hmac-secret-at-least-32-bytes"
# Legacy aliases are accepted temporarily for existing installations. Prefer the names above.
ID_LOOKUP_SECRET=""
FIELD_ENCRYPTION_KEY=""
NEXTAUTH_URL="http://localhost:3000"
# Optional lead time before a workshop can be finalized; 0 means start must not be in the past.
WORKSHOP_MIN_START_LEAD_MINUTES="0"
ERROR_MONITORING_PROVIDER="development"
ERROR_MONITORING_DSN=""
ERROR_MONITORING_API_KEY=""
LOG_LEVEL="info"
RATE_LIMIT_STORE="memory"
RATE_LIMIT_REDIS_URL=""
RATE_LIMIT_REDIS_TOKEN=""
# Development-only seed guard and demo account. Never set ATHAR_SEED in production.
ATHAR_SEED="false"
SEED_DEMO_EMAIL="demo.manager@athar.local"
SEED_DEMO_PASSWORD="Demo-only-password-123!"
